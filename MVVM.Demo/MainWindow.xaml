<Window x:Class="MVVM.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отдел кадров" Height="400" Width="750"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <!-- MenuViewModel -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10"
                    DataContext="{Binding Menu}">
            <Button Content="Открыть..." Width="100" Margin="0,0,8,0" Command="{Binding OpenCommand}" />
            <Button Content="Сохранить..." Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
            <Button Content="Сохранить в папку..." Width="140" Margin="0,0,8,0" Command="{Binding SaveToFolderCommand}" />
            <Button Content="Выход" Width="100" Command="{Binding ExitCommand}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <!-- MainViewModel -->
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Компании" FontWeight="Bold" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Companies}"
                         SelectedItem="{Binding SelectedCompany}"
                         DisplayMemberPath="Name" />
            </DockPanel>

            <!-- EmployeesViewModel -->
            <DockPanel Grid.Column="1" DataContext="{Binding Employees}">
                <TextBlock DockPanel.Dock="Top" Text="Сотрудники" FontWeight="Bold" Margin="0,0,0,4" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Уволить" Width="90" Margin="0,0,8,0" Command="{Binding FireCommand}" />
                    <Button Content="Сохранить в файл..." Width="130" Command="{Binding SaveCommand}" />
                </StackPanel>
                <ListView ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Имя" Width="90" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Фамилия" Width="100" DisplayMemberBinding="{Binding Surname}" />
                            <GridViewColumn Header="Email" Width="120" DisplayMemberBinding="{Binding Email}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <!-- UnemployedViewModel -->
            <DockPanel Grid.Column="2" Margin="10,0,0,0" DataContext="{Binding Unemployed}">
                <TextBlock DockPanel.Dock="Top" Text="Без работы" FontWeight="Bold" Margin="0,0,0,4" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Нанять в компанию" Margin="0,0,0,8" Command="{Binding HireCommand}" />
                    <Button Content="Сохранить в файл..." Command="{Binding SaveCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" />
                                <Run Text="{Binding Surname, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
